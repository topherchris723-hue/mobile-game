{
  "name": "rule13-file-sound-no-credits-row",
  "ops": [
    {
      "file": "audio.json",
      "op": "set",
      "path": [
        "sounds",
        "sfx_heavy"
      ],
      "value": {
        "source": "file",
        "gain": 0.8,
        "path": "assets/audio/hit_heavy.ogg",
        "license": "CC0",
        "credit": "Jane Doe"
      }
    }
  ],
  "files": [
    "assets/audio/hit_heavy.ogg"
  ],
  "expect": {
    "errorRule": "13-licensing",
    "errorContains": "no assets/CREDITS.md row with File \"assets/audio/hit_heavy.ogg\" and License \"CC0\""
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "data/schemas/economy.schema.json",
  "title": "Economy (data/economy.json)",
  "description": "Currencies, starting state, duplicate rules, power formula. GDD §9.1, §11.4, §12.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "currencies", "starting", "duplicates", "power_formula"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "currencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "icon", "max", "real_money"],
        "properties": {
          "id": { "type": "string", "pattern": "^cur_[a-z0-9_]+$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 16 },
          "icon": { "type": "string", "pattern": "^ico_[a-z0-9_]+$" },
          "max": { "type": "integer", "minimum": 1, "maximum": 99999999 },
          "real_money": {
            "description": "Must be false: no real-money currency until the owner says otherwise.",
            "const": false
          }
        }
      }
    },
    "starting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currencies", "characters", "team"],
      "properties": {
        "currencies": {
          "type": "object",
          "propertyNames": { "pattern": "^cur_[a-z0-9_]+$" },
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "characters": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^char_[a-z][a-z0-9]*_[0-9]{3}$" }
        },
        "team": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^char_[a-z][a-z0-9]*_[0-9]{3}$" }
        }
      }
    },
    "duplicates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_resonance", "stat_bonus_per_rank", "overflow_currency_id", "overflow_amount_by_rarity"],
      "properties": {
        "max_resonance": { "type": "integer", "minimum": 0, "maximum": 10 },
        "stat_bonus_per_rank": { "type": "number", "minimum": 0, "maximum": 0.2 },
        "overflow_currency_id": { "type": "string", "pattern": "^cur_[a-z0-9_]+$" },
        "overflow_amount_by_rarity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["3", "4", "5"],
          "properties": {
            "3": { "type": "integer", "minimum": 0 },
            "4": { "type": "integer", "minimum": 0 },
            "5": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "power_formula": {
      "description": "fighter_power = floor(HP*hp + ATK*atk + DEF*def)",
      "type": "object",
      "additionalProperties": false,
      "required": ["hp", "atk", "def"],
      "properties": {
        "hp": { "type": "number", "minimum": 0 },
        "atk": { "type": "number", "minimum": 0 },
        "def": { "type": "number", "minimum": 0 }
      }
    }
  }
}

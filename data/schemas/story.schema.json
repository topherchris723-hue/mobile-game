{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "data/schemas/story.schema.json",
  "title": "Story scenes (data/story.json)",
  "description": "Short dialogue scenes shown before/after stages. GDD §10.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "scenes"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scene" }
    }
  },
  "$defs": {
    "assetKey": { "type": "string", "pattern": "^(por|spr|bg|bgm|sfx|vfx|ico|art)_[a-z0-9_]+$" },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["speaker", "side", "text"],
      "properties": {
        "speaker": {
          "description": "A character id, 'narrator', or 'npc' (then 'name' is required).",
          "type": "string",
          "pattern": "^(narrator|npc|char_[a-z][a-z0-9]*_[0-9]{3})$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 16 },
        "side": { "enum": ["left", "right", "center"] },
        "expression": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "text": { "type": "string", "minLength": 1, "maxLength": 140 }
      },
      "allOf": [
        {
          "if": { "properties": { "speaker": { "const": "npc" } } },
          "then": { "required": ["name"] }
        }
      ]
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "background", "lines"],
      "properties": {
        "id": { "type": "string", "pattern": "^scene_[a-z0-9_]+$" },
        "background": { "$ref": "#/$defs/assetKey" },
        "bgm": { "$ref": "#/$defs/assetKey" },
        "lines": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "$ref": "#/$defs/line" } }
      }
    }
  }
}
